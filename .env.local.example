# ============================================================================
# Hibranso — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.
# ============================================================================

# Supabase project URL and anon (public) key.
# Find these in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp number that receives customer orders, digits only, with country
# code and NO leading +, spaces or dashes. Example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Public URL this site is deployed at (used for SEO metadata, sitemap, OG tags,
# and PhonePe's redirect URL). Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SECRET — server-only. Never prefix these with NEXT_PUBLIC_.
# ----------------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API -> service_role key.
# Used in exactly one place: confirming a PhonePe payment server-to-server.
# See README section 3 ("The one service-role-key exception").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Delhivery business/API account (README section 6b). Leave both of these
# unset/blank to use a flat delivery fee instead (see FLAT_DELIVERY_FEE below)
# — useful if your Delhivery account isn't activated yet. The moment both are
# set, live Delhivery rates take over automatically.
DELHIVERY_API_TOKEN=your-delhivery-api-token
DELHIVERY_ORIGIN_PINCODE=000000

# Flat delivery fee (in rupees), used only when DELHIVERY_API_TOKEN /
# DELHIVERY_ORIGIN_PINCODE are not set. Defaults to 149 if omitted entirely.
FLAT_DELIVERY_FEE=149

# PhonePe Business Dashboard -> Developer Settings (README section 6c).
PHONEPE_CLIENT_ID=your-phonepe-client-id
PHONEPE_CLIENT_SECRET=your-phonepe-client-secret
PHONEPE_CLIENT_VERSION=1
# sandbox while testing, production once live
PHONEPE_ENV=sandbox
# Invent these, then set the same pair in PhonePe's webhook configuration.
PHONEPE_WEBHOOK_USERNAME=your-chosen-webhook-username
PHONEPE_WEBHOOK_PASSWORD=your-chosen-webhook-password
